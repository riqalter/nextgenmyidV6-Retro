{
  "name": "mikail-thoriq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:full": "tsc -p tsconfig.api.json --noEmit false --outDir .local-api --rootDir . && node --env-file=.env scripts/dev-full.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check:web": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:api": "tsc -p tsconfig.api.json",
    "check": "npm run check:web && npm run check:api",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:preview": "node scripts/preview-smoke.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.10.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.14"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "^5.2.8",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/vt323": "^5.2.8"
  }
}
