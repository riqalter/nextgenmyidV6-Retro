# Copy to .env. All credentials are server-only; never prefix them PUBLIC_.
# Optional read-only public GitHub token, used only during builds.
GITHUB_TOKEN=

# Required for the contact form. Create a Resend key with Sending access.
# Verify the FROM domain in Resend by adding its DNS records first.
RESEND_API_KEY=
RESEND_TO=
RESEND_FROM=
RESEND_FROM_NAME="Mikail Thoriq — portfolio"

# Shared contact quota (Upstash Redis REST, standard token with EVAL permission).
# Both are required to send mail. Missing/unavailable limits disable sending.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global requests accepted per 24h window; also 5 per IP per minute.
CONTACT_DAILY_LIMIT=25

# Optional exact origin, without trailing slash. Leave blank for same-host checks
# on localhost and Vercel/Netlify previews; set the production origin only in
# the production deployment context (e.g. https://mikailthoriq.my.id).
ALLOWED_ORIGIN=

# Optional: set 1 to skip GitHub fetching (offline build/CI).
GITHUB_OFFLINE=0
